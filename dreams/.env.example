# Vibe Trade - AI Trading Intelligence Nanoservice
# BASE_PRIVATE_KEY and BASE_RPC_URL are required to enable x402 payments; everything else falls back to defaults.

# Agent HTTP configuration
# Optional. Port that Bun will listen on locally.
PORT=8787
# Optional. Base URL surfaced in the agent manifest for absolute links.
API_BASE_URL=http://localhost:8787

# LLM Configuration (for routing decisions)
# Required for intelligent routing. If not set, uses fallback logic.
OPENAI_API_KEY=your_openai_api_key_here

# Chain configuration
# Optional. RPC endpoint used for ERC-8004 trust interactions.
RPC_URL=
# Optional. Set to true to auto-register the agent identity at startup.
REGISTER_IDENTITY=false
# Optional. Payment network identifier (e.g. base, base-sepolia).
NETWORK=base-sepolia
# Optional unless monetization is enabled. Facilitator API base URL.
FACILITATOR_URL=https://facilitator.daydreams.systems

# x402 Payments Configuration
# Required. Address that receives x402 payments from clients.
PAY_TO=0xb308ed39d67D0d4BAe5BC2FAEF60c66BBb6AE429
# Optional. Default price (in wei) when no entrypoint price is set.
# Vibe Trade entrypoint: 100000 wei = $0.10 USDC
DEFAULT_PRICE=100000

# Base Network Configuration (for x402 payments)
# Required. Base RPC endpoint for transaction execution
BASE_RPC_URL=https://mainnet.base.org
# Required. Private key of wallet that will make x402 payments for services
# This wallet needs USDC balance to pay for TAAPI, AIXBT, and other x402 services
BASE_PRIVATE_KEY=0x...

# Data Source Configuration
# TAAPI - Standard REST API (not x402)
TAAPI_API_KEY=your_taapi_api_key_here

# AIXBT - x402 Endpoint (requires BASE_PRIVATE_KEY to be set)
AIXBT_ENDPOINT=https://api.aixbt.tech/x402/agents/indigo

# Dreams LLM Router
DREAMS_ROUTER_URL=https://router.daydreams.systems

# Secrets (Legacy - kept for backwards compatibility)
# Deprecated. Use BASE_PRIVATE_KEY instead for x402 payments.
PRIVATE_KEY=